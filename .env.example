# VAYVOR environment. Copy to .env.local (git-ignored). Names only here; never commit values.
#
# The app works fully without any of these (everything stays on the device).

# Cloud backup, accounts and Circle (Supabase project: Settings -> API). Apply every migration in order first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign-in providers that are ACTUALLY configured in Supabase (comma separated). Only listed ones are shown.
# Add google only after the Google provider, its client id/secret and the callback URL are set up.
VITE_AUTH_PROVIDERS=

# Background reminders (Web Push). Public key only: it is safe in the client bundle.
# The private key and the rest live as Supabase Edge Function secrets, never in the client:
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, CRON_SECRET
# Generate a key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
