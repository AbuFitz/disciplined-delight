# Copy to .env.local (git-ignored) and fill in from your Supabase project
# settings (Project Settings -> API). Also add the same two values as
# environment variables in Vercel so the deployed build picks them up.
#
# Until these are set, the app runs on localStorage only — see src/lib/supabase.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
