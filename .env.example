# Copy to .env.local (git-ignored) and fill in. Names only here; never commit values.
#
# The app works fully without any of these (everything stays on the device).

# Cloud backup / multi-device sync (Supabase project: Settings -> API). Apply supabase/migrations/0001..0004 first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Background reminders (Web Push). Public key only: it is safe in the client bundle.
# The private key and the rest live as Supabase Edge Function secrets, never in the client:
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, CRON_SECRET
# Generate a key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
